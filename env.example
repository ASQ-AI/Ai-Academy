# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The email that unlocks the admin dashboard ("إدارة الأكاديمية").
ADMIN_EMAIL=asq-ai@opentech.ae

# The deployed site URL, used to build the magic-link redirect (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
